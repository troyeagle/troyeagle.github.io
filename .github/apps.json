{
  "schema": 1,
  "apps": {
    "clue": {
      "enabled": true,
      "repository": "troyeagle/larp-clues-presentation",
      "branch": "main",
      "workflow": "publish-static.yml",
      "buildJob": "Build static application",
      "artifact": "site-clue",
      "destination": "clue",
      "allowSourceMaps": true
    },
    "countdown": {
      "enabled": true,
      "repository": "troyeagle/larp-countdown",
      "branch": "main",
      "workflow": "publish-static.yml",
      "buildJob": "Publish static application / Build static application",
      "artifact": "site-countdown",
      "destination": "countdown",
      "allowSourceMaps": true
    },
    "clue-viewer": {
      "enabled": true,
      "repository": "troyeagle/clue-viewer",
      "branch": "master",
      "workflow": "publish-static.yml",
      "buildJob": "Publish static application / Build static application",
      "artifact": "site-clue-viewer",
      "destination": "clue-viewer",
      "allowSourceMaps": false
    },
    "merger": {
      "enabled": true,
      "repository": "troyeagle/image-merger-fe",
      "branch": "main",
      "workflow": "publish-static.yml",
      "buildJob": "Publish static application / Build static application",
      "artifact": "site-merger",
      "destination": "merger",
      "allowSourceMaps": false
    }
  }
}
